import cv2
import face_recognition
import pickle
import numpy as np
import os
import time

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
ENCODINGS_PATH = os.path.join(BASE_DIR, "encodings.pkl")

# === Carregar encodings ===
with open(ENCODINGS_PATH, "rb") as f:
    data = pickle.load(f)

known_encodings = data["encodings"]
known_names = data["names"]

# === Webcam ajustada para performance ===
cap = cv2.VideoCapture(0)
cap.set(3, 640)   # largura realista
cap.set(4, 480)   # altura realista

print("Pressione ESC para sair.")

fps_counter = 0
fps_time = time.time()

# Detectar a cada 3 frames
FRAME_SKIP = 3
frame_count = 0
face_locations = []
face_encodings = []
face_names = []

while True:
    ret, frame = cap.read()
    if not ret:
        break

    # Resize para acelerar (1/4 do tamanho)
    small_frame = cv2.resize(frame, (0, 0), fx=0.25, fy=0.25)
    rgb_small = cv2.cvtColor(small_frame, cv2.COLOR_BGR2RGB)

    frame_count += 1

    # Só detecta a cada N frames
    if frame_count % FRAME_SKIP == 0:
        face_locations = face_recognition.face_locations(rgb_small, model="hog")
        face_encodings = face_recognition.face_encodings(rgb_small, face_locations)

        face_names = []
        for enc in face_encodings:
            matches = face_recognition.compare_faces(known_encodings, enc, tolerance=0.6)
            name = "Desconhecido"

            distances = face_recognition.face_distance(known_encodings, enc)
            best = np.argmin(distances)

            if matches[best]:
                confidence = 1 - distances[best]
                name = f"{known_names[best]} ({confidence:.2f})"

            face_names.append(name)

    # Desenhar no frame original (coordenadas voltam ao tamanho real)
    for (top, right, bottom, left), name in zip(face_locations, face_names):
        top *= 4
        right *= 4
        bottom *= 4
        left *= 4
        
        color = (0, 255, 0) if "Desconhecido" not in name else (0, 0, 255)
        cv2.rectangle(frame, (left, top), (right, bottom), color, 2)
        cv2.rectangle(frame, (left, bottom - 35), (right, bottom), color, cv2.FILLED)
        cv2.putText(frame, name, (left + 6, bottom - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

    # FPS
    fps_counter += 1
    if time.time() - fps_time >= 1.0:
        fps = fps_counter
        fps_counter = 0
        fps_time = time.time()
        cv2.putText(frame, f"FPS: {fps}", (10, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)

    cv2.imshow("Reconhecimento Facial", frame)

    if cv2.waitKey(1) & 0xFF == 27:
        break

cap.release()
cv2.destroyAllWindows()
