import cv2
import face_recognition

# === Carregar imagens conhecidas ===
andre_img = face_recognition.load_image_file("dataset_teste/andre.jpg")
duda_img = face_recognition.load_image_file("dataset_teste/duda.jpg")


# Gerar encodings (representações dos rostos)
andre_encoding = face_recognition.face_encodings(andre_img)[0]
duda_encoding = face_recognition.face_encodings(duda_img)[0]

known_encodings = [andre_encoding, duda_encoding]
known_names = ["André", "Duda"]

# === Iniciar webcam ===
video_capture = cv2.VideoCapture(0)

while True:
    ret, frame = video_capture.read()
    if not ret:
        break

    # Reduz tamanho pra acelerar processamento
    small_frame = cv2.resize(frame, (0, 0), fx=0.5, fy=0.5)
    rgb_small_frame = small_frame[:, :, ::-1]

    # Detectar e codificar rostos no frame atual
    face_locations = face_recognition.face_locations(rgb_small_frame)
    face_encodings = face_recognition.face_encodings(rgb_small_frame, face_locations)

    for (top, right, bottom, left), face_encoding in zip(face_locations, face_encodings):
        # Comparar o rosto detectado com os rostos conhecidos
        matches = face_recognition.compare_faces(known_encodings, face_encoding, tolerance=0.45)
        name = "Desconhecido"

        if True in matches:
            match_index = matches.index(True)
            name = known_names[match_index]

        # Redimensionar coordenadas (voltando ao tamanho original)
        top *= 2
        right *= 2
        bottom *= 2
        left *= 2

        # Escolher cor do retângulo
        color = (0, 255, 255)  # amarelo padrão
        if name == "André":
            color = (0, 255, 0)  # verde
        elif name == "Duda":
            color = (255, 0, 255)  # rosa

        # Desenhar retângulo e nome
        cv2.rectangle(frame, (left, top), (right, bottom), color, 2)
        cv2.rectangle(frame, (left, bottom - 25), (right, bottom), color, cv2.FILLED)
        cv2.putText(frame, name, (left + 6, bottom - 6),
                    cv2.FONT_HERSHEY_DUPLEX, 0.7, (0, 0, 0), 1)

    # Exibir vídeo
    cv2.imshow("Reconhecimento Facial - Pressione Q para sair", frame)

    # Encerrar com Q
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

video_capture.release()
cv2.destroyAllWindows()
