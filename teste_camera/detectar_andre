import cv2
import face_recognition

# === Carregar imagens conhecidas ===
andre_img = face_recognition.load_image_file("dataset/andre.jpg")
colega_img = face_recognition.load_image_file("dataset/colega.jpg")

andre_encoding = face_recognition.face_encodings(andre_img)[0]
colega_encoding = face_recognition.face_encodings(colega_img)[0]

known_encodings = [andre_encoding, colega_encoding]
known_names = ["André", "Colega"]

# === Iniciar webcam ===
video_capture = cv2.VideoCapture(0)

while True:
    ret, frame = video_capture.read()
    if not ret:
        break

    small_frame = cv2.resize(frame, (0, 0), fx=0.5, fy=0.5)
    rgb_small_frame = small_frame[:, :, ::-1]

    face_locations = face_recognition.face_locations(rgb_small_frame)
    face_encodings = face_recognition.face_encodings(rgb_small_frame, face_locations)

    face_names = []
    for face_encoding in face_encodings:
        matches = face_recognition.compare_faces(known_encodings, face_encoding, tolerance=0.45)
        name = "Desconhecido"

        if True in matches:
            first_match_index = matches.index(True)
            name = known_names[first_match_index]

        face_names.append(name)

    # Mostrar resultado com quadrado e nome
    for (top, right, bottom, left), name in zip(face_locations, face_names):
        top *= 2
        right *= 2
        bottom *= 2
        left *= 2

        # Retângulo amarelo
        cv2.rectangle(frame, (left, top), (right, bottom), (0, 255, 255), 2)

        # Caixa com o nome
        cv2.rectangle(frame, (left, bottom - 25), (right, bottom), (0, 255, 255), cv2.FILLED)
        cv2.putText(frame, name, (left + 5, bottom - 5), cv2.FONT_HERSHEY_DUPLEX, 0.7, (0, 0, 0), 1)

    cv2.imshow('Reconhecimento Facial - André e Colega', frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

video_capture.release()
cv2.destroyAllWindows()
